# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → Data API → Project URL. Just https://<project-id>.supabase.co
# with nothing after it (leave off /rest/v1). The NEXT_PUBLIC_ names also work.
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…)
SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server only, keep private.
# Used for image uploads from the admin (stored in a public "media" Storage bucket).
SUPABASE_SECRET_KEY=

# Email(s) allowed into /admin, comma-separated. Must match the user you create in
# Supabase → Authentication → Users.
ADMIN_EMAILS=

# Supabase → Connect → Transaction pooler URI (port 6543). Used by the site.
DATABASE_URL=
# Supabase → Connect → Session pooler URI (port 5432). Used for migrations and seeding.
DATABASE_URL_SESSION=

# Optional: email alerts for contact form messages (https://resend.com → API Keys).
RESEND_API_KEY=
# Where alerts go. Defaults to the first ADMIN_EMAILS address.
CONTACT_TO_EMAIL=
# Sender. Leave empty to use Resend's test sender, which only delivers to the email
# you signed up to Resend with. After verifying your domain: Portfolio <hello@yourdomain.com>
RESEND_FROM=
